class Charta < Formula
  desc "Reference toolchain for Company as Code"
  homepage "https://github.com/Pirol-ai/company-as-code"
  version "__VERSION__"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/Pirol-ai/company-as-code/releases/download/v__VERSION__/charta-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_DARWIN_ARM64__"
    else
      url "https://github.com/Pirol-ai/company-as-code/releases/download/v__VERSION__/charta-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_DARWIN_X64__"
    end
  end

  on_linux do
    url "https://github.com/Pirol-ai/company-as-code/releases/download/v__VERSION__/charta-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "__SHA_LINUX_X64__"
  end

  def install
    bin.install "charta"
  end

  test do
    assert_match "charta", shell_output("#{bin}/charta 2>&1", 2)
  end
end
